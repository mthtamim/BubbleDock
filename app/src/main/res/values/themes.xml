<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BubbleDock" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bd_bg</item>
        <item name="android:statusBarColor">@color/bd_bg</item>
        <item name="colorAccent">@color/bd_accent</item>
    </style>
    <style name="BD.Heading" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bd_text</item>
    </style>
    <style name="BD.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/bd_text_body</item>
    </style>
    <style name="BD.Caption" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/bd_text_secondary</item>
    </style>
    <style name="BD.Button" parent="">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/bd_on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
